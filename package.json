{
  "name": "starter-crax-ts",
  "version": "1.0.0",
  "packageManager": "pnpm@10.6.5",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "crax mono build",
    "dev": "crax mono dev",
    "lint": "eslint --cache .",
